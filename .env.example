# Database
DATABASE_URL=postgresql+psycopg://subauditor:subauditor@localhost:5432/subscription_auditor

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Auth
# Generate with: python -c "import secrets;print(secrets.token_hex(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Token encryption (AES-GCM key, base64-encoded 32 bytes)
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Google OAuth (Gmail read-only)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/connections/gmail/callback

# LLM (optional; rule-based fallback used if absent)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.4-nano

# Email provider (Resend)
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=alerts@your-domain.com

# App
FRONTEND_URL=http://localhost:3000
RENEWAL_LEAD_DAYS=2
# Gmail scan window (days): default, maximum a user may pick, and per-scan message cap
GMAIL_SCAN_DAYS=90
GMAIL_SCAN_MAX_DAYS=90
GMAIL_SCAN_MAX_MESSAGES=2000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
